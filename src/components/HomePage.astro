<script define:vars={{ finalLine1: copy.heroLine1, finalLine2: copy.heroLine2, questionLine2: copy.heroQuestion }}>
  const line1 = document.querySelector("[data-hero-line1]");
  const line2 = document.querySelector("[data-hero-line2]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (line1 && line2 && !reducedMotion) {
    const type = (element, text, speed, done) => {
      element.textContent = "";
      let index = 0;
      const timer = window.setInterval(() => {
        element.textContent += text[index];
        index += 1;
        if (index >= text.length) {
          window.clearInterval(timer);
          done?.();
        }
      }, speed);
    };

    const erase = (element, speed, done) => {
      const timer = window.setInterval(() => {
        element.textContent = element.textContent.slice(0, -1);
        if (!element.textContent) {
          window.clearInterval(timer);
          done();
        }
      }, speed);
    };

    line1.textContent = finalLine1.replace(/\.$/, ",");
    type(line2, questionLine2, 48, () => {
      window.setTimeout(() => {
        erase(line2, 24, () => {
          line1.textContent = finalLine1;
          type(line2, finalLine2, 42);
        });
      }, 1300);
    });
  }
</script>
