---
interface Props {
  id?: string;
  reverse?: boolean;
  tone?: "paper" | "white" | "soft" | "dark";
  mediaPosition?: "cover" | "contain";
}

const {
  id,
  reverse = false,
  tone = "paper",
  mediaPosition = "cover",
} = Astro.props;
---

<section
  {id}
  class:list={[
    "editorial-split",
    `tone-${tone}`,
    `media-${mediaPosition}`,
    { reverse },
  ]}
>
  <div class="copy"><slot /></div>
  <div class="media"><slot name="media" /></div>
</section>

<style>
  .editorial-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: 560px;
    border-top: 1px solid var(--editorial-line, #d7dad7);
    background: var(--editorial-paper, #fbfaf6);
  }

  .editorial-split.reverse .copy {
    order: 2;
  }

  .editorial-split.reverse .media {
    order: 1;
  }

  .copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: clamp(3.5rem, 8vw, 7rem) var(--editorial-pad, clamp(1.25rem, 5vw, 4rem));
  }

  .media {
    min-width: 0;
    overflow: hidden;
    background: #e8ebe8;
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    min-height: 560px;
    object-fit: cover;
    filter: grayscale(100%);
  }

  .media-contain .media :global(img) {
    object-fit: contain;
  }

  .tone-white {
    background: #fff;
  }

  .tone-soft {
    background: var(--editorial-soft, #eef1ed);
  }

  .tone-dark {
    background: var(--editorial-ink, #0b0d0c);
    color: #fff;
  }

  @media (max-width: 800px) {
    .editorial-split {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .editorial-split.reverse .copy,
    .editorial-split.reverse .media {
      order: initial;
    }

    .media :global(img) {
      min-height: 280px;
      max-height: 440px;
    }
  }
</style>
