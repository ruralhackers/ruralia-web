---
import Base from "../layouts/Base.astro";
import { getTalleresCampaign, type Locale } from "../data/talleres-otono-2026";
import "../styles/editorial.css";
import SectionTag from "./ui/SectionTag.astro";
import EditorialSplit from "./ui/EditorialSplit.astro";
import PriceCard from "./ui/PriceCard.astro";
import CtaBand from "./ui/CtaBand.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const campaign = getTalleresCampaign(locale);
const isGl = locale === "gl";
const homeUrl = isGl ? "/" : "/es/";
const canonicalPath = isGl
  ? "/talleres-otono-2026/"
  : "/es/talleres-otono-2026/";
const imageSrcset = (name: string) =>
  [480, 800, 1200]
    .map(
      (width) =>
        `/images/talleres-otono-2026/${name}-${width}.webp ${width}w`,
    )
    .join(", ");

const schema = [
  ...campaign.workshops.map((workshop) => ({
    "@context": "https://schema.org",
    "@type": "Event",
    name: `${workshop.title} · Rural GPT`,
    description: workshop.description,
    startDate: `${workshop.dateISO}T09:00:00+01:00`,
    endDate: `${workshop.dateISO}T18:00:00+01:00`,
    eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
    eventStatus: "https://schema.org/EventScheduled",
    maximumAttendeeCapacity: workshop.capacity,
    inLanguage: locale,
    image: `https://ruralgpt.gal/images/talleres-otono-2026/${
      workshop.id === "productivity" ? "tareas-mierderas" : "equipo"
    }.webp`,
    location: {
      "@type": "Place",
      name: "Anceu Coliving",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Ponte Caldelas",
        addressRegion: "Pontevedra",
        addressCountry: "ES",
      },
    },
    organizer: {
      "@type": "Organization",
      name: "Rural GPT",
      url: "https://ruralgpt.gal",
    },
    offers: {
      "@type": "Offer",
      url: workshop.stripeUrl,
      price: workshop.price,
      priceCurrency: "EUR",
      availability: "https://schema.org/InStock",
      priceSpecification: {
        "@type": "UnitPriceSpecification",
        price: workshop.price,
        priceCurrency: "EUR",
        valueAddedTaxIncluded: false,
      },
    },
  })),
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: campaign.faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: isGl ? "Inicio" : "Inicio",
        item: `https://ruralgpt.gal${homeUrl}`,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: campaign.navLabel,
        item: `https://ruralgpt.gal${canonicalPath}`,
      },
    ],
  },
];
---

<Base
  title={campaign.seo.title}
  description={campaign.seo.description}
  keywords={campaign.seo.keywords}
  schema={schema}
  ogImage="/images/talleres-otono-2026/entorno-anceu.webp"
  ogImageAlt={campaign.venue.imageAlt}
>
  <div class="editorial-page">
    <section class="workshop-hero">
      <div class="ed-container">
        <SectionTag text={campaign.hero.eyebrow} />
        <h1>{campaign.hero.title}</h1>
        <div class="hero-copy">
          <p class="hero-intro">{campaign.hero.intro}</p>
          <p>{campaign.hero.body}</p>
        </div>
        <p class="hero-meta">{campaign.hero.meta}</p>
        <nav class="hero-options" aria-label={campaign.workshopsHeading}>
          {
            campaign.workshops.map((workshop) => (
              <a href={`#${workshop.id}`}>
                <span>{workshop.dateShort}</span>
                <strong>{workshop.shortTitle}</strong>
                <span aria-hidden="true">↓</span>
              </a>
            ))
          }
          <a href="#pack">
            <span>{campaign.pack.tag}</span>
            <strong>{campaign.pack.priceLabel}</strong>
            <span aria-hidden="true">↓</span>
          </a>
        </nav>
      </div>
    </section>

    <EditorialSplit id="contexto" tone="white">
      <SectionTag text={campaign.context.tag} />
      <h2 class="ed-heading">{campaign.context.title}</h2>
      {campaign.context.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      <img
        slot="media"
        src="/images/talleres-otono-2026/tareas-mierderas.webp"
        srcset={imageSrcset("tareas-mierderas")}
        sizes="(max-width: 800px) 100vw, 50vw"
        alt={campaign.context.imageAlt}
        width="1200"
        height="900"
        loading="lazy"
      />
    </EditorialSplit>

    <section id="talleres" class="ed-section ed-section--white">
      <div class="ed-container">
        <SectionTag text={isGl ? "Os talleres" : "Los talleres"} />
        <h2 class="ed-heading">{campaign.workshopsHeading}</h2>
        <p class="ed-lead">{campaign.workshopsIntro}</p>
      </div>
    </section>

    {
      campaign.workshops.map((workshop, index) => (
        <article id={workshop.id} class:list={["workshop", { alternate: index % 2 }]}>
          <header class="workshop-head">
            <p class="workshop-number">{workshop.eyebrow}</p>
            <p class="workshop-date">{workshop.dateShort}</p>
            <h2>{workshop.title}</h2>
            <p class="workshop-hook">{workshop.hook}</p>
            <p class="workshop-description">{workshop.description}</p>
          </header>
          <div class="workshop-detail">
            <section>
              <h3>{isGl ? "Para quen é" : "Para quién es"}</h3>
              <ul class="ed-list">
                {workshop.audience.map((item) => <li>{item}</li>)}
              </ul>
            </section>
            <section>
              <h3>{isGl ? "Que traballaremos" : "Qué trabajaremos"}</h3>
              <ul class="ed-list">
                {workshop.topics.map((item) => <li>{item}</li>)}
              </ul>
            </section>
            <aside class="workshop-result">
              <span>{isGl ? "Resultado" : "Resultado"}</span>
              <p>{workshop.result}</p>
            </aside>
          </div>
        </article>
      ))
    }

    <section id="reservas" class="ed-section reservation-section">
      <div class="ed-container">
        <SectionTag text={isGl ? "Reserva" : "Reserva"} />
        <h2 class="ed-heading">
          {isGl ? "Escolle un día. Ou queda cos dous." : "Elige un día. O quédate con los dos."}
        </h2>
        <p class="tax-warning">
          {isGl
            ? "Os prezos indicados non inclúen o IVA."
            : "Los precios indicados no incluyen el IVA."}
        </p>
        <div class="price-grid">
          {
            campaign.workshops.map((workshop) => (
              <PriceCard
                eyebrow={workshop.eyebrow}
                title={workshop.title}
                date={workshop.dateLabel}
                priceLabel={workshop.priceLabel}
                taxNote={isGl ? "IVA non incluído" : "IVA no incluido"}
                href={workshop.stripeUrl}
                cta={workshop.cta}
              >
                <p>{workshop.result}</p>
              </PriceCard>
            ))
          }
          <PriceCard
            eyebrow={campaign.pack.tag}
            title={campaign.pack.title}
            priceLabel={campaign.pack.priceLabel}
            taxNote={isGl ? "IVA non incluído" : "IVA no incluido"}
            href={campaign.pack.stripeUrl}
            cta={campaign.pack.cta}
            featured
          >
            <p>{campaign.pack.body}</p>
            <p><strong>{campaign.pack.savingLabel}</strong></p>
          </PriceCard>
        </div>
      </div>
    </section>

    <EditorialSplit id="inclue" reverse tone="soft">
      <SectionTag text={isGl ? "A xornada" : "La jornada"} />
      <div class="include-columns">
        <section>
          <h2>{campaign.includesHeading}</h2>
          <dl>
            {
              campaign.includes.map((item) => (
                <div>
                  <dt>{item.title}</dt>
                  <dd>{item.detail}</dd>
                </div>
              ))
            }
          </dl>
        </section>
        <section>
          <h2>{campaign.excludesHeading}</h2>
          <ul class="ed-list">
            {campaign.excludes.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      </div>
      <img
        slot="media"
        src="/images/talleres-otono-2026/que-pagas.webp"
        srcset={imageSrcset("que-pagas")}
        sizes="(max-width: 800px) 100vw, 50vw"
        alt={campaign.includesImageAlt}
        width="1200"
        height="900"
        loading="lazy"
      />
    </EditorialSplit>

    <section id="pack" class="pack-section">
      <div>
        <SectionTag text={campaign.pack.tag} inverted />
        <h2>{campaign.pack.title}</h2>
        <p>{campaign.pack.body}</p>
      </div>
      <div class="pack-price">
        <strong>{campaign.pack.priceLabel}</strong>
        <span>{campaign.pack.savingLabel}</span>
        <a href={campaign.pack.stripeUrl} rel="noopener">
          {campaign.pack.cta}<span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <EditorialSplit id="proba-social" tone="white">
      <SectionTag text={campaign.testimonial.tag} />
      <h2 class="ed-heading">{campaign.testimonial.title}</h2>
      <blockquote>{campaign.testimonial.quote}</blockquote>
      <p><strong>{campaign.testimonial.conclusion}</strong></p>
      <img
        slot="media"
        src="/images/talleres-otono-2026/sara-testimonial.webp"
        srcset={imageSrcset("sara-testimonial")}
        sizes="(max-width: 800px) 100vw, 50vw"
        alt={campaign.testimonial.imageAlt}
        width="1200"
        height="900"
        loading="lazy"
      />
    </EditorialSplit>

    <EditorialSplit id="onde" reverse>
      <SectionTag text={campaign.venue.tag} />
      <h2 class="ed-heading">{campaign.venue.title}</h2>
      {campaign.venue.body.map((paragraph) => <p>{paragraph}</p>)}
      <a class="text-link" href={campaign.venue.mapUrl} target="_blank" rel="noopener">
        {campaign.venue.mapLabel}<span aria-hidden="true">↗</span>
      </a>
      <img
        slot="media"
        src="/images/talleres-otono-2026/entorno-anceu.webp"
        srcset={imageSrcset("entorno-anceu")}
        sizes="(max-width: 800px) 100vw, 50vw"
        alt={campaign.venue.imageAlt}
        width="1600"
        height="1067"
        loading="lazy"
      />
    </EditorialSplit>

    <EditorialSplit tone="soft">
      <SectionTag text={isGl ? "Comida incluída" : "Comida incluida"} />
      <h2 class="ed-heading">{campaign.venue.foodTitle}</h2>
      <p>{campaign.venue.foodBody}</p>
      <img
        slot="media"
        src="/images/talleres-otono-2026/comida-incluida.webp"
        srcset={imageSrcset("comida-incluida")}
        sizes="(max-width: 800px) 100vw, 50vw"
        alt={campaign.venue.foodImageAlt}
        width="1200"
        height="900"
        loading="lazy"
      />
    </EditorialSplit>

    <section id="equipo" class="ed-section ed-section--white team-section">
      <div class="ed-container">
        <div class="team-intro">
          <div>
            <SectionTag text={campaign.teamHeading} />
            <h2 class="ed-heading">{campaign.teamHeading}</h2>
          </div>
          <p class="ed-lead">{campaign.teamIntro}</p>
        </div>
        <img
          class="team-photo"
          src="/images/talleres-otono-2026/equipo.webp"
          srcset={imageSrcset("equipo")}
          sizes="(max-width: 800px) 100vw, 1240px"
          alt={campaign.teamImageAlt}
          width="1600"
          height="900"
          loading="lazy"
        />
        <div class="team-grid">
          {
            campaign.team.map((member, index) => (
              <article>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{member.name}</h3>
                <p class="member-role">{member.role}</p>
                <p>{member.bio}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="faq" class="ed-section faq-section">
      <div class="ed-container faq-layout">
        <div>
          <SectionTag text="FAQ" />
          <h2 class="ed-heading">{campaign.faqHeading}</h2>
        </div>
        <div class="faq-list">
          {
            campaign.faq.map((item, index) => (
              <details>
                <summary>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  {item.question}
                </summary>
                <p>{item.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <CtaBand
      title={campaign.finalCta.title}
      body={campaign.finalCta.body}
      href={campaign.pack.stripeUrl}
      label={campaign.pack.cta}
      external
    >
      <p>{campaign.finalCta.productivity}</p>
      <p>{campaign.finalCta.web}</p>
      <p>{campaign.finalCta.pack}</p>
    </CtaBand>

    <section class="contact-strip">
      <h2>{campaign.contact.title}</h2>
      <p>
        {campaign.contact.body.split("hola@ruralgpt.gal")[0]}
        <a class="contact-mail" href="mailto:hola@ruralgpt.gal">hola@ruralgpt.gal</a>
        {campaign.contact.body.split("hola@ruralgpt.gal")[1]}
      </p>
    </section>

    <a class="mobile-reserve" href="#reservas">
      {isGl ? "Ver prezos" : "Ver precios"}<span aria-hidden="true">↑</span>
    </a>
  </div>
</Base>

<style>
  .workshop-hero {
    padding: clamp(4rem, 8vw, 7rem) var(--editorial-pad) 0;
    background: var(--editorial-paper);
  }

  .workshop-hero h1 {
    max-width: 1120px;
    margin: 0;
    font-family: var(--editorial-display);
    font-size: clamp(4.25rem, 12vw, 11rem);
    font-weight: 400;
    line-height: 0.86;
    letter-spacing: 0.005em;
    text-wrap: balance;
  }

  .hero-copy {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 8vw, 8rem);
    margin: clamp(2.5rem, 6vw, 5rem) 0 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--editorial-line);
  }

  .hero-copy p {
    color: var(--editorial-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .hero-copy .hero-intro {
    color: var(--editorial-ink);
    font-size: clamp(1.25rem, 2.4vw, 1.7rem);
    font-weight: 650;
    line-height: 1.5;
  }

  .hero-meta {
    margin-bottom: 2.5rem;
    color: var(--editorial-accent);
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-options {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-inline: calc(var(--editorial-pad) * -1);
    border-top: 1px solid var(--editorial-line);
    background: var(--editorial-line);
    gap: 1px;
  }

  .hero-options a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.35rem 1rem;
    min-height: 128px;
    align-content: center;
    padding: 1.5rem var(--editorial-pad);
    background: #fff;
    color: var(--editorial-ink);
    text-decoration: none;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .hero-options a:hover {
    background: var(--editorial-accent);
    color: #fff;
  }

  .hero-options span:first-child {
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-options strong {
    grid-column: 1;
    font-size: 1.05rem;
  }

  .hero-options span:last-child {
    grid-column: 2;
    grid-row: 1 / 3;
    align-self: center;
    font-size: 1.4rem;
  }

  :global(.editorial-split p) {
    max-width: 65ch;
    color: var(--editorial-muted);
    font-size: 1rem;
    line-height: 1.75;
  }

  .workshop {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    border-top: 1px solid var(--editorial-line);
    background: #fff;
  }

  .workshop.alternate {
    background: var(--editorial-soft);
  }

  .workshop-head,
  .workshop-detail {
    padding: clamp(3rem, 7vw, 6rem) var(--editorial-pad);
  }

  .workshop-head {
    border-right: 1px solid var(--editorial-line);
  }

  .workshop-number,
  .workshop-date {
    color: var(--editorial-accent);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .workshop-date {
    margin: clamp(3rem, 8vw, 7rem) 0 0;
    font-family: var(--editorial-display);
    font-size: clamp(4.5rem, 10vw, 9rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: 0;
  }

  .workshop h2 {
    margin: 1rem 0;
    font-family: var(--editorial-display);
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: 0.005em;
  }

  .workshop-hook {
    max-width: 28ch;
    font-size: clamp(1.25rem, 2.5vw, 1.65rem);
    font-weight: 700;
    line-height: 1.4;
  }

  .workshop-description,
  .workshop-detail p {
    color: var(--editorial-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .workshop-detail {
    display: grid;
    align-content: center;
    gap: 3rem;
  }

  .workshop-detail h3 {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .workshop-result {
    padding: 2rem;
    border-left: 4px solid var(--editorial-accent);
    background: #fff;
  }

  .workshop-result span {
    color: var(--editorial-accent);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .workshop-result p {
    margin: 0.75rem 0 0;
    color: var(--editorial-ink);
    font-weight: 650;
  }

  .reservation-section {
    background: var(--editorial-paper);
  }

  .tax-warning {
    margin-bottom: 2rem;
    color: var(--editorial-accent);
    font-weight: 700;
  }

  .price-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .include-columns {
    display: grid;
    gap: 3rem;
  }

  .include-columns h2 {
    margin: 0 0 1.5rem;
    font-family: var(--editorial-display);
    font-size: 2.5rem;
    font-weight: 400;
    letter-spacing: 0.005em;
  }

  dl {
    margin: 0;
  }

  dl div {
    padding: 1rem 0;
    border-top: 1px solid var(--editorial-line);
  }

  dt {
    font-weight: 750;
  }

  dd {
    margin: 0.2rem 0 0;
    color: var(--editorial-muted);
  }

  .pack-section {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 3rem;
    padding: clamp(4rem, 8vw, 7rem) var(--editorial-pad);
    background: var(--editorial-accent);
    color: #fff;
  }

  .pack-section h2 {
    max-width: 850px;
    margin: 0 0 1rem;
    color: inherit;
    font-family: var(--editorial-display);
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: 0.005em;
  }

  .pack-section p {
    max-width: 65ch;
    color: #dce9e1;
  }

  .pack-price {
    display: flex;
    min-width: 280px;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .pack-price strong {
    font-size: clamp(2.2rem, 5vw, 4rem);
    letter-spacing: -0.05em;
  }

  .pack-price span {
    font-size: 0.78rem;
  }

  .pack-price a {
    display: flex;
    width: 100%;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
    margin-top: 1rem;
    padding: 0.85rem 1rem;
    border: 1px solid #fff;
    background: #fff;
    color: var(--editorial-accent);
    font-size: 0.78rem;
    font-weight: 750;
    text-decoration: none;
    text-transform: uppercase;
  }

  blockquote {
    margin: 0 0 1.5rem;
    padding-left: 1.5rem;
    border-left: 3px solid var(--editorial-accent);
    color: var(--editorial-ink);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    font-weight: 600;
    line-height: 1.65;
  }

  .text-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.6rem;
    color: var(--editorial-accent);
    font-weight: 750;
  }

  .team-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: end;
  }

  .team-photo {
    width: 100%;
    max-height: 680px;
    margin: 3rem 0 0;
    object-fit: cover;
    filter: grayscale(100%);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-left: 1px solid var(--editorial-line);
  }

  .team-grid article {
    padding: 2rem;
    border-right: 1px solid var(--editorial-line);
  }

  .team-grid article > span,
  .member-role {
    color: var(--editorial-accent);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .team-grid h3 {
    margin: 2rem 0 0.4rem;
    font-size: 1.25rem;
  }

  .team-grid p:last-child {
    color: var(--editorial-muted);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .faq-section {
    background: var(--editorial-paper);
  }

  .faq-layout {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .faq-list {
    border-top: 1px solid var(--editorial-line);
  }

  details {
    border-bottom: 1px solid var(--editorial-line);
  }

  summary {
    display: grid;
    grid-template-columns: 2rem 1fr;
