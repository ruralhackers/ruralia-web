---
import Base from "../layouts/Base.astro";

const linkCompartida = import.meta.env.PUBLIC_STRIPE_LINK_COMPARTIDA;
const linkIndividual = import.meta.env.PUBLIC_STRIPE_LINK_INDIVIDUAL;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Event",
    name: "Rural GPT — Residencia de IA aplicada en Galicia",
    description:
      "Residencia inmersiva de IA aplicada para profesionais. 3 días de formación práctica + aloxamento + comidas en Anceu Coliving, Galicia.",
    startDate: "2026-06-04",
    endDate: "2026-06-07",
    eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
    eventStatus: "https://schema.org/EventScheduled",
    location: {
      "@type": "Place",
      name: "Anceu Coliving",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Ponte Caldelas",
        addressRegion: "Pontevedra",
        addressCountry: "ES",
      },
    },
    organizer: {
      "@type": "Organization",
      name: "Rural GPT",
      url: "https://ruralgpt.gal",
    },
    offers: [
      {
        "@type": "Offer",
        name: "Cuarto compartido",
        price: "632",
        priceCurrency: "EUR",
        availability: "https://schema.org/InStock",
      },
      {
        "@type": "Offer",
        name: "Cuarto individual",
        price: "797",
        priceCurrency: "EUR",
        availability: "https://schema.org/InStock",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Inicio",
        item: "https://ruralgpt.gal/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Residencia de IA en Galicia",
        item: "https://ruralgpt.gal/residencia-ia-galicia/",
      },
    ],
  },
];

const tools = [
  {
    name: "ChatGPT",
    desc: "O asistente máis versátil para texto, análise e conversación",
    logo: "/logos/openai.svg",
    href: "https://chatgpt.com",
  },
  {
    name: "Claude",
    desc: "Razoamento profundo e traballo con documentos longos",
    logo: "/logos/anthropic.svg",
    href: "https://claude.ai",
  },
  {
    name: "Gemini",
    desc: "A IA de Google integrada co teu ecosistema",
    logo: "/logos/googlegemini.svg",
    href: "https://gemini.google.com",
  },
  {
    name: "Kimi",
    desc: "Modelo de razoamento avanzado open source",
    logo: "/logos/kimi.svg",
    href: "https://kimi.ai",
  },
  {
    name: "Cursor",
    desc: "Programa e edita código con IA como copiloto",
    logo: "/logos/cursor.svg",
    href: "https://cursor.com",
  },
  {
    name: "Runway",
    desc: "Xera vídeo e imaxes con IA profesional",
    logo: "/logos/runway.svg",
    href: "https://runwayml.com",
  },
  {
    name: "Bolt",
    desc: "De idea a prototipo funcional en minutos",
    logo: "/logos/bolt.svg",
    href: "https://bolt.new",
  },
  {
    name: "Lovable",
    desc: "Crea aplicacións web completas sen programar",
    logo: "/logos/lovable.svg",
    href: "https://lovable.dev",
  },
  {
    name: "v0",
    desc: "Xera compoñentes UI cunha descrición",
    logo: "/logos/vercel.svg",
    href: "https://v0.dev",
  },
  {
    name: "Make",
    desc: "Automatiza fluxos de traballo entre aplicacións",
    logo: "/logos/make.svg",
    href: "https://make.com",
  },
  {
    name: "Perplexity",
    desc: "Busca intelixente con fontes verificadas",
    logo: "/logos/perplexity.svg",
    href: "https://perplexity.ai",
  },
  {
    name: "NotebookLM",
    desc: "Converte documentos en coñecemento interactivo",
    logo: "/logos/notebooklm.svg",
    href: "https://notebooklm.google.com",
  },
];
---

<Base
  title="Residencia de IA en Galicia — 3 días, todo incluído | Rural GPT"
  description="Ponte ao día con IA en 3 días. Formación práctica en Anceu Coliving, Pontevedra. Aloxamento, comidas e ferramentas incluídas. 12 prazas. Dende 632 EUR."
  keywords={[
    "residencia IA Galicia",
    "curso intensivo IA presencial",
    "poñerse ao día con IA",
    "formación IA todo incluído",
    "curso IA Anceu Coliving",
  ]}
  schema={schema}
>
  <!-- Hero -->
  <section class="section hero-residencia">
    <div class="section-inner text-center">
      <h1>Ponte ao día con IA en 3 días. Todo incluído.</h1>
      <p class="hero-sub">
        Isto é para ti se sentes que a IA vai máis rápido do que podes
        procesar e queres "un cortalumes". En 3 días filtramos o ruído e
        dámosche as ferramentas exactas para que a túa experiencia profesional se
        potencie, non se oxide.
      </p>
      <p class="hero-sub">
        Nós investigamos por ti — e seguimos facéndoo cada semana. Ti
        vés 3 días a Galicia e vas con as ferramentas de IA configuradas
        para o teu traballo.
      </p>
      <a href="#" class="btn btn-primary btn-lg" onclick="event.preventDefault(); window.openNewsletter && window.openNewsletter();"
        >Lista de espera</a
      >
      <p class="hero-price">
        Dende <span id="hero-price-from">632</span> EUR todo incluído · 4–7 xuño
        2026
      </p>
    </div>
  </section>

  <!-- Datos clave -->
  <section class="section alt">
    <div class="section-inner">
      <div class="key-facts">
        <div class="fact">
          <strong>Cando</strong>
          <span>4–7 xuño 2026</span>
        </div>
        <div class="fact">
          <strong>Onde</strong>
          <span>Anceu Coliving, Ponte Caldelas (Pontevedra)</span>
        </div>
        <div class="fact">
          <strong>Duración</strong>
          <span>3 días / 3 noites</span>
        </div>
        <div class="fact">
          <strong>Prazas</strong>
          <span>12 persoas</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Que inclúe -->
  <section class="section alt">
    <div class="section-inner">
      <h2>Que inclúe</h2>
      <div class="includes-grid">
        <div class="include-item">
          <strong>Formación</strong>
          <p>3 días de obradoiros prácticos con ferramentas de IA</p>
        </div>
        <div class="include-item">
          <strong>Aloxamento</strong>
          <p>3 noites en Anceu Coliving</p>
        </div>
        <div class="include-item">
          <strong>Comidas</strong>
          <p>Almorzo, xantar e cea os 3 días. Gastronomía galega.</p>
        </div>
        <div class="include-item">
          <strong>Materiais</strong>
          <p>
            Acceso a todas as ferramentas, licenzas e materiais do curso
          </p>
        </div>
        <div class="include-item">
          <strong>Comunidade alumni</strong>
          <p>Acceso ao grupo privado de alumni despois da Residencia IA</p>
        </div>
        <div class="include-item">
          <strong>Follow-up</strong>
          <p>Sesión online grupal de seguimento ás 2-3 semanas</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Ferramentas -->
  <section class="section">
    <div class="section-inner">
      <h2>Ferramentas que aprenderás a usar</h2>
      <p>
        Non todas as ferramentas de IA serven para o mesmo. Nós probámolas,
        ti lévas as que encaixan co teu traballo.
      </p>
      <div class="tools-grid">
        {
          tools.map((tool) => (
            <a
              class="tool-card"
              href={tool.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div class="tool-top">
                <img
                  class="tool-logo"
                  src={tool.logo}
                  alt={tool.name}
                  width="28"
                  height="28"
                />
                <span class="tool-arrow">↗</span>
              </div>
              <p class="tool-name">{tool.name}</p>
              <p class="tool-desc">{tool.desc}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Programa detallado -->
  <section class="section">
    <div class="section-inner">
      <h2>Programa: De "non me entero" a "xa o teño claro".</h2>

      <div class="day-detail">
        <h3>Xoves — "¿Onde estou?" — Mapa do terreo</h3>
        <p>
          Chegas despois de xantar. Situámoste. Que ferramentas existen, para que serve cada unha, cales
          son fume e cales merecen o teu tempo. Sairás do primeiro día entendendo o
          panorama completo da IA aplicada a traballo real.
        </p>
      </div>

      <div class="day-detail">
        <h3>Venres — "¿Que podo automatizar?" — O teu traballo baixo a lupa</h3>
        <p>
          Analizamos o teu fluxo de traballo real. Identificamos que tarefas podes
          automatizar, delegar á IA ou facer na metade de tempo. Aprendes a
          usar as ferramentas clave: ChatGPT, Claude, Gemini, Make.
        </p>
      </div>

      <div class="day-detail">
        <h3>Sábado — "¿Podo construír cousas?" — De idea a prototipo</h3>
        <p>
          Si, podes. Aínda que non saibas programar. Con Cursor, Bolt, Lovable e v0
          constrúes ferramentas que antes terías encargado (e pagado). Montas
          o teu kit definitivo e sairás con todo configurado e listo para o luns.
        </p>
      </div>

      <div class="day-detail">
        <h3>Domingo — Peche e despedida</h3>
        <p>
          Almorzo xuntos, últimas dúbidas e despedida antes da hora de xantar.
        </p>
      </div>
    </div>
  </section>

  <!-- Día típico -->
  <section class="section">
    <div class="section-inner">
      <h2>Un día típico</h2>
      <div class="schedule">
        <div class="schedule-row">
          <span class="time">9:00</span><span>Almorzo xuntos</span>
        </div>
        <div class="schedule-row">
          <span class="time">10:00 – 13:30</span><span
            >Obradoiro práctico (hands-on con ferramentas)</span>
        </div>
        <div class="schedule-row">
          <span class="time">13:30</span><span>Xantar</span>
        </div>
        <div class="schedule-row">
          <span class="time">15:30 – 18:00</span><span
            >Aplicar o aprendido ao teu propio proxecto</span>
        </div>
        <div class="schedule-row">
          <span class="time">18:00 – 19:30</span><span
            >Tempo libre, paseo, descanso</span>
        </div>
        <div class="schedule-row">
          <span class="time">20:00</span><span>Cea</span>
        </div>
        <div class="schedule-row">
          <span class="time">21:30</span><span
            >Sesión nocturna opcional — demos, preguntas, charla</span>
        </div>
      </div>
    </div>
  </section>

  <!-- O lugar + credibilidade -->
  <section class="section alt">
    <div class="section-inner">
      <h2>O lugar: Anceu Coliving</h2>
      <p>
        O primeiro coliving do noroeste de España. Un pobo de menos de 100
        habitantes en Ponte Caldelas (Pontevedra), con 1 Gbps de fibra óptica,
        espazo de traballo equipado, e rodeado de natureza. O 55% dos
        colivers repiten.
      </p>
      <p>
        A 30 minutos de Pontevedra e 45 de Vigo. Se vés en avión, o
        aeroporto máis cercano é Vigo (VGO).
      </p>

      <h2>Quen o organiza</h2>
      <p>
        Rural GPT é unha iniciativa de <a
          href="https://ruralhackers.com"
          target="_blank"
          rel="noopener">Rural Hackers</a
        > e <a href="https://anceu.com" target="_blank" rel="noopener"
          >Anceu Coliving</a
        >. Levamos anos organizando eventos tech no rural galego — Hacker
        Days, residencias creativas, hackathons con participantes de toda
        Europa.
      </p>
      <div class="team-inline">
        <p>
          <strong>Agustín Jamardo</strong> — Fundador de Anceu Coliving. Desenvolvedor,
          12+ anos en remoto.
        </p>
        <p>
          <strong>África Rodríguez</strong> — Cofundadora de Rural Hackers. Facilitadora
          de proxectos europeos (Erasmus+).
        </p>
        <p>
          <strong>Nacho Márquez</strong> — Cofundador de Rural Hackers. Director de
          Noites Abertas. 20+ proxectos internacionais.
        </p>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="section alt" id="pricing">
    <div class="section-inner pricing-section">
      <h2>Prezo</h2>
      <p class="pricing-intro">
        Todo incluído: formación, aloxamento, comidas, materiais e comunidade
        alumni.
      </p>
      <div
        class="pricing-grid"
        data-prices='[
          {"until":null,"label":"Prezo normal","until_text":"","discount":"","compartida":632,"individual":797}
        ]'
      >
        <div class="price-card featured" id="card-individual">
          <div class="room-title">Cuarto individual</div>
          <div class="room-subtitle">Cuarto só para ti</div>
          <span class="price-amount" id="price-individual">797 EUR</span>
          <span class="price-tier" id="tier-individual"
            >Prezo normal</span>
          <span class="price-discount" id="discount-individual"
            ></span
          >
          <ul>
            <li>3 días de formación</li>
            <li>3 noites de aloxamento</li>
            <li>Todas as comidas</li>
            <li>Comunidade alumni</li>
            <li>Sesión follow-up</li>
          </ul>
          <p class="deposit-note">150 € agora · resto antes da chegada</p>
          <span class="btn btn-sold-out" aria-disabled="true">Esgotada</span>
        </div>
        <div class="price-card" id="card-compartida">
          <div class="room-title">Cuarto compartido</div>
          <div class="room-subtitle">Compartido con outra persoa</div>
          <span class="price-amount" id="price-compartida">632 EUR</span>
          <span class="price-tier" id="tier-compartida"
            >Prezo normal</span>
          <span class="price-discount" id="discount-compartida"
            ></span
          >
          <ul>
            <li>3 días de formación</li>
            <li>3 noites de aloxamento</li>
            <li>Todas as comidas</li>
            <li>Comunidade alumni</li>
            <li>Sesión follow-up</li>
          </ul>
          <p class="deposit-note">100 € agora · resto antes da chegada</p>
          <span class="btn btn-sold-out" aria-disabled="true">Esgotada</span>
        </div>
      </div>
      <div
        id="pricing-countdown"
        style="display:none;"
        class="countdown-banner"
      >
        <span class="countdown-label" id="countdown-label"></span>
        <span class="countdown-timer" id="countdown-timer"></span>
        <span class="countdown-next" id="countdown-next"></span>
      </div>
      <p class="pricing-note">
        Un bootcamp de IA en Madrid custa 2.450–7.000 EUR sen aloxamento nin
        comidas. <a href="/faq/">¿Máis preguntas?</a>
      </p>
    </div>
  </section>

  <!-- FAQ inline -->
  <section class="section">
    <div class="section-inner">
      <h2>Preguntas rápidas</h2>
      <div class="faq-inline">
        <details>
          <summary>¿Necesito saber programar?</summary>
          <p>Non. Se sabes usar un navegador, podes seguir o programa.</p>
        </details>
        <details>
          <summary>¿É só para xente de tecnoloxía?</summary>
          <p>
            Non. É para calquera profesional que queira integrar IA no seu
            traballo: deseño, administración, marketing, consultoría,
            servizos...
          </p>
        </details>
        <details>
          <summary>¿E se xa uso ChatGPT?</summary>
          <p>
            Perfecto, pero probablemente o uses ao 10% da súa capacidade. Aquí
            vas moito máis aló.
          </p>
        </details>
        <details>
          <summary>¿Que pasa se a IA que aprendo queda obsoleta?</summary>
          <p>
            Por iso non che ensinamos UNHA ferramenta. Ensinámoche a avaliar e
            elixir. E a comunidade alumni segue activa con actualizacións.
          </p>
        </details>
      </div>
      <p class="faq-more">
        <a href="/faq/">Ver todas as preguntas frecuentes</a>
      </p>
    </div>
  </section>

  <!-- Contacto -->
  <section class="section alt" id="reservar">
    <div class="section-inner form-section">
      <h2>¿Tes dúbidas? Escríbenos</h2>
      <p class="form-subtitle">
        ¿Tes algunha pregunta antes de reservar? Respondémosche en menos de
        24h.
      </p>

      <form
        name="contacto-residencia"
        method="POST"
        action="/grazas-contacto/"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="waitlist-form"
      >
        <input type="hidden" name="form-name" value="contacto-residencia" />
        <p class="hidden-field">
          <label>Non encher: <input name="bot-field" /></label>
        </p>

        <div class="form-group">
          <label for="nombre">Nome</label>
          <input
            type="text"
            id="nombre"
            name="nombre"
            required
            placeholder="O teu nome"
          />
        </div>

        <div class="form-group">
          <label for="email">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="ti@email.com"
          />
        </div>

        <div class="form-group">
          <label for="mensaje">¿Que queres saber?</label>
          <textarea
            id="mensaje"
            name="mensaje"
            rows="3"
            placeholder="Cóntanos a túa dúbida..."></textarea>
        </div>

        <button type="submit" class="btn btn-primary btn-lg">Enviar</button>
      </form>
    </div>
  </section>
</Base>

<style>
  /* ===== Hero residencia ===== */
  .hero-residencia {
    padding-top: 5rem;
    padding-bottom: 4rem;
  }
  .section-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .hero-residencia h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    max-width: 700px;
    margin: 0 auto 1.5rem;
  }
  .hero-sub {
    font-size: 1.15rem;
    color: var(--color-text-secondary);
    max-width: 580px;
    margin: 0 auto 2rem;
    line-height: 1.7;
  }
  .hero-price {
    color: var(--marron-claro);
    font-size: 0.95rem;
    margin-top: 1rem;
  }

  .highlight-text {
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 2.5vw, 1.5rem);
    color: var(--verde-bosque);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.4;
    margin-top: 1.5rem;
    margin-bottom: 0;
  }

  .key-facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .fact-full {
    grid-column: 1 / -1;
  }
  .fact {
    background: #f5f5f5;
    padding: 1rem;
    border-radius: 8px;
    text-align: center;
  }
  .fact strong {
    display: block;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #888;
    margin-bottom: 0.25rem;
  }

  .alt {
    background: #f5f5f5;
  }

  .day-detail {
    margin-bottom: 2rem;
  }
  .day-detail h3 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }
  .day-detail p {
    color: #555;
  }

  .schedule {
    max-width: 600px;
  }
  .schedule-row {
    display: flex;
    gap: 1.5rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid #e0e0e0;
  }
  .time {
    font-weight: 600;
    min-width: 130px;
    color: #555;
    font-size: 0.9rem;
  }

  .includes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 1rem;
  }
  .include-item {
    background: #fff;
    padding: 1.25rem;
    border-radius: 8px;
  }
  .include-item strong {
    display: block;
    margin-bottom: 0.25rem;
  }
  .include-item p {
    color: #666;
    font-size: 0.9rem;
    margin: 0;
  }

  .pricing-section {
    text-align: center;
  }
  .pricing-intro {
    color: #666;
    margin-bottom: 0;
  }
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    max-width: 680px;
    margin: 2rem auto;
  }
  .price-card {
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 12px;
    padding: 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
  }
  .price-card.featured {
    background: #000;
    border-color: #000;
    color: #fff;
  }
  .room-title {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.2rem;
  }
  .room-subtitle {
    font-size: 0.85rem;
    color: #888;
    margin-bottom: 1.25rem;
  }
  .price-card.featured .room-subtitle {
    color: rgba(255, 255, 255, 0.55);
  }
  .price-amount {
    display: block;
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 0.2rem;
  }
  .price-tier {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #888;
    margin-bottom: 0.2rem;
    min-height: 1em;
  }
  .price-card.featured .price-tier {
    color: rgba(255, 255, 255, 0.5);
  }
  .price-discount {
    display: block;
    font-size: 0.85rem;
    color: #555;
    font-weight: 500;
    margin-bottom: 1.5rem;
    min-height: 1.2em;
  }
  .price-card.featured .price-discount {
    color: rgba(255, 255, 255, 0.7);
  }
  .price-card ul {
    text-align: left;
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    flex: 1;
  }
  .price-card li {
