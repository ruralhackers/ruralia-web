---
import { Image } from "astro:assets";
import heroPhoto from "../assets/images/ruralia-1.jpg";
import Base from "../layouts/Base.astro";

const linkCompartida = import.meta.env.PUBLIC_STRIPE_LINK_COMPARTIDA;
const linkIndividual = import.meta.env.PUBLIC_STRIPE_LINK_INDIVIDUAL;

const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "ruralGPT",
  url: "https://ruralgpt.gal",
  description:
    "Residencia inmersiva de IA aplicada para profesionais. 3 días en Galicia.",
  foundingDate: "2026",
  sameAs: [],
};

const days = [
  {
    num: "Xoves",
    title: "¿Onde estou?",
    subtitle: "Mapa do terreo",
    desc: "Chegas despois de xantar. Situámoste: que ferramentas existen, para que serve cada unha, cales son fume e cales merecen o teu tempo.",
  },
  {
    num: "Venres",
    title: "¿Que podo automatizar?",
    subtitle: "O teu traballo baixo a lupa",
    desc: "Analizamos o teu fluxo de traballo real. Que tarefas podes automatizar, delegar á IA ou facer na metade de tempo.",
  },
  {
    num: "Sábado",
    title: "¿Podo construír cousas?",
    subtitle: "De idea a prototipo e o teu stack",
    desc: "Aínda que non saibas programar. Constrúes ferramentas reais con IA. Montas o teu kit definitivo e sairás con todo configurado.",
  },
];

const inclusions = [
  "3 días de formación práctica",
  "3 noites de aloxamento",
  "Todas as comidas incluídas",
  "Materiais e licenzas",
  "Comunidade alumni",
  "Sesión de seguimento online",
];

const tools = [
  {
    name: "ChatGPT",
    desc: "Probablemente xa o uses. Aquí vas moito máis aló do 10% da súa capacidade.",
    logo: "/logos/openai.svg",
    href: "https://chatgpt.com",
  },
  {
    name: "Claude",
    desc: "Para razoamento e documentos longos. Mellor que ChatGPT para certas tarefas.",
    logo: "/logos/anthropic.svg",
    href: "https://claude.ai",
  },
  {
    name: "Gemini",
    desc: "A IA de Google. Integrada con Gmail, Docs e Drive.",
    logo: "/logos/googlegemini.svg",
    href: "https://gemini.google.com",
  },
  {
    name: "Cursor",
    desc: "Escribe código con IA como copiloto. Aínda que non saibas programar.",
    logo: "/logos/cursor.svg",
    href: "https://cursor.com",
  },
  {
    name: "Bolt",
    desc: "De idea a prototipo en minutos. Para validar antes de investir tempo.",
    logo: "/logos/bolt.svg",
    href: "https://bolt.new",
  },
  {
    name: "Lovable",
    desc: "Crea aplicacións web completas describindo o que necesitas.",
    logo: "/logos/lovable.svg",
    href: "https://lovable.dev",
  },
  {
    name: "v0",
    desc: "Xera compoñentes de interface cunha descrición. Para deseñadores e devs.",
    logo: "/logos/vercel.svg",
    href: "https://v0.dev",
  },
  {
    name: "Make",
    desc: "Automatiza fluxos entre aplicacións. Sen programar.",
    logo: "/logos/make.svg",
    href: "https://make.com",
  },
  {
    name: "Perplexity",
    desc: "Busca con IA que cita as fontes. Para investigar sen perderse.",
    logo: "/logos/perplexity.svg",
    href: "https://perplexity.ai",
  },
  {
    name: "NotebookLM",
    desc: "Converte documentos nunha base de coñecemento interactiva.",
    logo: "/logos/notebooklm.svg",
    href: "https://notebooklm.google.com",
  },
  {
    name: "Runway",
    desc: "Xera e edita vídeo con IA. Para os que traballan con contido.",
    logo: "/logos/runway.svg",
    href: "https://runwayml.com",
  },
  {
    name: "Kimi 2.5",
    desc: "Modelo open source potente de Moonshot AI. Para tarefas avanzadas.",
    logo: "/logos/kimi.svg",
    href: "https://kimi.ai",
  },
];
---

<Base
  title="ruralGPT — Residencia inmersiva de IA aplicada en Galicia"
  description="3 días en Galicia para poñerte ao día con IA. Formación práctica, aloxamento e comidas incluídas. 12 prazas. 4–7 xuño 2026."
  keywords={[
    "residencia IA España",
    "curso IA inmersivo",
    "formación IA Galicia",
    "residencia intelixencia artificial",
  ]}
  schema={schema}
  hideHeader={true}
>
  <!-- ===== NAV ===== -->
  <header class="nav">
    <a href="/" class="nav-logo">
      <img
        src="/images/logo-ruralgpt.png"
        alt="ruralGPT"
        style="height:32px;width:auto;display:block;"
      />
    </a>
    <nav class="nav-links" id="home-nav">
      <a href="/residencia-ia-galicia/">Residencia IA</a>
      <a href="/para-quen/">Para quen</a>
      <a href="/blog/">Blog</a>
      <a href="/faq/">FAQ</a>
      <a href="/sobre-nos/">Quen somos</a>
    </nav>
    <a href="#" class="nav-cta" onclick="event.preventDefault(); window.openNewsletter && window.openNewsletter();">Lista de espera</a>
    <a href="/es/" class="nav-lang" aria-label="Cambiar a español">ES</a>
    <button
      class="nav-toggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="home-nav"
    >
      <span></span>
      <span></span>
    </button>
  </header>

  <!-- ===== HERO ===== -->
  <section class="hero">
    <div class="hero-top">
      <h1 class="hero-headline">
        <span id="hero-line1"></span><br />
        <span class="hero-headline-q" id="hero-line2"></span>
      </h1>
    </div>
    <div class="hero-sub">
      <div class="hero-sub-text">
        <p>
          <strong>A IA non che vai quitar o traballo, pero un profesional que sabe
          usala si.</strong> Por iso esta residencia é un sprint para integrar IA no teu
          fluxo de traballo real. Só 12 profesionais poderán participar e
          <strong>a experiencia é un todo incluído</strong> dende a formación ata o
          aloxamento, comida e ocio.
        </p>
        <p class="hero-date">
          4–7 de xuño 2026 · <a
            href="https://anceu.com"
            target="_blank"
            rel="noopener">Anceu Coliving</a
          >
        </p>
      </div>
      <a href="#" class="btn-dark" onclick="event.preventDefault(); window.openNewsletter && window.openNewsletter();">Lista de espera</a>
    </div>
    <div class="hero-photo">
      <Image
        src={heroPhoto}
        alt="Anceu Coliving entre árbores con néboa matinal en Galicia"
        widths={[640, 960, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <a href="/residencia-ia-galicia/" class="hero-learn-link">
      Aprende IA en 3 días en Galicia →
    </a>
  </section>

  <!-- ===== O RUÍDO ===== -->
  <section class="section noise">
    <div class="noise-grid">
      <div class="noise-left">
        <p class="tag">Que é ruralGPT</p>
        <p>
          Unha experiencia inmersiva de IA aplicada para profesionais. <strong>3 días en
          Galicia. Formación práctica, aloxamento e comidas incluídas.</strong> Grupos
          de 12 persoas.
        </p>
      </div>
      <div class="noise-right">
        <p class="noise-stmt">
          Non é un curso online. Non é teoría. Non é un máster de meses.
        </p>
        <hr class="noise-rule" />
        <p class="noise-stmt">
          É traballo real con ferramentas reais aplicadas ao teu traballo.
        </p>
        <hr class="noise-rule" />
        <p class="noise-stmt">
          Chegas con dúbidas. Sairás co teu stack configurado.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== PROTOCOLO 3 DÍAS ===== -->
  <section class="section protocol">
    <h2 class="protocol-h">
      Non deixes que o ritmo da tecnoloxía che deixe fóra do mercado.
    </h2>
    <p class="protocol-intro">
      Isto é o que faremos en 3 días para que actualices o teu stack profesional
      e recuperes o control da túa carreira con IA aplicada de verdade.
    </p>
    <div class="protocol-grid">
      {
        days.map((day) => (
          <div class="protocol-card">
            <span class="protocol-num">{day.num}</span>
            <div class="protocol-body">
              <h3 class="protocol-title">{day.title}</h3>
              <p class="protocol-sub">{day.subtitle}</p>
              <p class="protocol-desc">{day.desc}</p>
            </div>
            <span class="protocol-plus">+</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ===== FERRAMENTAS ===== -->
  <section class="section tools">
    <p class="tag">Ferramentas que aprenderás a usar</p>
    <div class="tools-grid">
      {
        tools.map((tool) => (
          <a
            class="tool-card"
            href={tool.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="tool-top">
              <img
                class="tool-logo"
                src={tool.logo}
                alt={tool.name}
                width="28"
                height="28"
                loading="lazy"
              />
              <span class="tool-arrow">↗</span>
            </div>
            <p class="tool-name">{tool.name}</p>
            <p class="tool-desc">{tool.desc}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ===== ONDE VIVIRÁS ESTA EXPERIENCIA ===== -->
  <section class="section arch">
    <p class="tag">Onde vivirás esta experiencia</p>
    <div class="arch-grid">
      <div class="arch-main">
        <img
          src="/images/room-102.webp"
          alt="Habitación 102 en Anceu Coliving"
          width="800"
          height="600"
          loading="lazy"
        />
      </div>
      <div class="arch-side">
        <div class="arch-card">
          <p class="arch-card-title">Cuarto individual</p>
          <p class="arch-card-desc">
            Só para ti. 3 noites incluídas no prezo.
          </p>
        </div>
        <div class="arch-card">
          <p class="arch-card-title">Cuarto compartido</p>
          <p class="arch-card-desc">Máx. 2 persoas. Opción máis económica.</p>
        </div>
        <div class="arch-card arch-card-dark">
          <a
            class="arch-card-title arch-card-link"
            href="https://anceu.com"
            target="_blank"
            rel="noopener">Anceu Coliving ↗</a
          >
          <p class="arch-card-desc">
            Pontevedra, Galicia. 1 Gbps. A 30 min da cidade.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PRICING ===== -->
  <section class="section" id="pricing">
    <div class="section-inner pricing-section">
      <h2>Prezo</h2>
      <p class="pricing-intro">
        Todo incluído: formación, aloxamento, comidas e comunidade alumni.
      </p>
      <div
        class="pricing-grid"
        data-prices='[
          {"until":null,"label":"Prezo normal","until_text":"","discount":"","compartida":632,"individual":797}
        ]'
      >
        <div class="price-card featured" id="card-individual">
          <div class="room-title">Cuarto individual</div>
          <div class="room-subtitle">Cuarto só para ti</div>
          <span class="price-amount" id="price-individual">797 EUR</span>
          <span class="price-tier" id="tier-individual"
            >Prezo normal</span
          >
          <span class="price-discount" id="discount-individual"
            ></span
          >
          <ul>
            <li>3 días de formación</li>
            <li>3 noites de aloxamento</li>
            <li>Todas as comidas</li>
            <li>Comunidade alumni</li>
            <li>Sesión follow-up</li>
          </ul>
          <p class="deposit-note">150 € agora · resto antes da chegada</p>
          <span class="btn btn-sold-out" aria-disabled="true">Esgotada</span>
        </div>
        <div class="price-card" id="card-compartida">
          <div class="room-title">Cuarto compartido</div>
          <div class="room-subtitle">Compartido con outra persoa</div>
          <span class="price-amount" id="price-compartida">632 EUR</span>
          <span class="price-tier" id="tier-compartida"
            >Prezo normal</span
          >
          <span class="price-discount" id="discount-compartida"
            ></span
          >
          <ul>
            <li>3 días de formación</li>
            <li>3 noites de aloxamento</li>
            <li>Todas as comidas</li>
            <li>Comunidade alumni</li>
            <li>Sesión follow-up</li>
          </ul>
          <p class="deposit-note">100 € agora · resto antes da chegada</p>
          <span class="btn btn-sold-out" aria-disabled="true">Esgotada</span>
        </div>
      </div>
      <div
        id="pricing-countdown"
        style="display:none;"
        class="countdown-banner"
      >
        <span class="countdown-label" id="countdown-label"></span>
        <span class="countdown-timer" id="countdown-timer"></span>
        <span class="countdown-next" id="countdown-next"></span>
      </div>
    </div>
  </section>

  <!-- ===== GPT ===== -->
  <section class="section gpt-section">
    <div class="gpt-intro-wrap">
      <p class="gpt-intro">
        Millóns de persoas usan ChatGPT cada día. Ti vaiche dar un novo
        significado a estas letras.
      </p>
    </div>
    <div class="gpt-grid">
      <div class="gpt-col">
        <span class="gpt-letter">G</span>
        <h3>Xerativo</h3>
        <p>
          Non recupera información: créaa. Aprenderás a xerar textos, ideas,
          código e prototipos que antes tardabas horas.
        </p>
      </div>
      <div class="gpt-col">
        <span class="gpt-letter">P</span>
        <h3>Preentrenado</h3>
        <p>
          Procesou máis coñecemento do que poderás ler na túa vida.
          Aprenderás a aproveitar todo ese contexto para o teu traballo específico.
        </p>
      </div>
      <div class="gpt-col">
        <span class="gpt-letter">T</span>
        <h3>Transformador</h3>
        <p>
          O modelo transforma a linguaxe. A experiencia transfórmache a ti.
          Sairás cunha forma distinta de traballar.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== CTA FINAL ===== -->
  <section class="cta-final">
    <h2 class="cta-headline">APRENDE IA.<br />EN 3 DÍAS.<br />EN GALICIA.</h2>
    <p class="cta-sub">
      Formación práctica, aloxamento e comidas incluídas. 12 prazas. Xuño
      2026.
    </p>
    <a href="#" class="btn-cta-final" onclick="event.preventDefault(); window.openNewsletter && window.openNewsletter();">Lista de espera</a>
  </section>

  <!-- ===== CONTACTO ===== -->
  <section class="section contact-section" id="contacto">
    <div class="section-inner contact-inner">
      <h2>¿Tes dúbidas? Escríbenos</h2>
      <form
        class="contact-form"
        name="contacto"
        method="POST"
        action="/grazas-contacto/"
        data-netlify="true"
      >
        <input type="hidden" name="form-name" value="contacto" />
        <div class="contact-row">
          <input
            type="text"
            name="nombre"
            placeholder="O teu nome"
            required
            class="contact-input"
          />
          <input
            type="email"
            name="email"
            placeholder="ti@email.com"
            required
            class="contact-input"
          />
        </div>
        <textarea
          name="mensaje"
          placeholder="Cóntanos a túa dúbida ou situación..."
          rows="4"
          required
          class="contact-input contact-textarea"></textarea>
        <button type="submit" class="btn btn-primary">Enviar mensaxe</button>
      </form>
    </div>
  </section>
</Base>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap");

  /* ============================================================
     TOKENS
  ============================================================ */
  :root {
    --black: #000000;
    --white: #ffffff;
    --gray-light: #f2f2f2;
    --gray-mid: #e0e0e0;
    --gray-text: #555555;
    --font-display: "Bebas Neue", sans-serif;
    --font-body: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
    --max: 1200px;
    --pad: clamp(1.5rem, 5vw, 4rem);
  }

  /* ============================================================
     NAV
  ============================================================ */
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 1.25rem var(--pad);
    background: var(--white);
    border-bottom: 1px solid var(--gray-mid);
  }
  .nav-logo {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--black);
    text-decoration: none;
    letter-spacing: 0.02em;
    margin-right: auto;
  }
  .nav-links {
    display: flex;
    gap: 2rem;
  }
  .nav-links a {
    font-size: 0.85rem;
    color: var(--gray-text);
    text-decoration: none;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: color 0.15s;
  }
  .nav-links a:hover {
    color: var(--black);
  }
  .nav-cta {
    background: #000;
    color: var(--white);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.55rem 1.25rem;
    border-radius: 4px;
    text-decoration: none;
    transition: background 0.15s;
  }
  .nav-cta:hover {
    background: #222;
    color: #ffffff;
  }
  .nav-cta:active {
    background: #00a66b;
    color: #ffffff;
  }
  .nav-lang {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #555;
    text-decoration: none;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 0.35rem 0.6rem;
    transition: color 0.15s, border-color 0.15s;
    flex-shrink: 0;
  }
  .nav-lang:hover {
    color: #000;
    border-color: #000;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    flex-shrink: 0;
  }
  .nav-toggle span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--black);
  }

  @media (max-width: 768px) {
    .nav-toggle {
      display: flex;
    }
    .nav-cta {
      display: none;
    }
    .nav-lang {
      display: none;
    }
    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--white);
      border-bottom: 1px solid #e0e0e0;
      flex-direction: column;
      padding: 1rem clamp(1.5rem, 5vw, 4rem);
      gap: 0;
      z-index: 99;
    }
    .nav-links.open {
      display: flex;
    }
    .nav-links a {
      padding: 0.75rem 0;
      border-bottom: 1px solid #f0f0f0;
      width: 100%;
      font-size: 1rem;
    }
    .nav-links a:last-child {
      border-bottom: none;
    }
  }

  /* ============================================================
     HERO
  ============================================================ */
  .hero {
    /* full width — no max-width, padding applied to sub-elements */
  }
  .hero-top {
    padding: 2.5rem var(--pad) 2rem;
  }
  .hero-headline {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 9vw, 8rem);
    line-height: 0.95;
    letter-spacing: 0.01em;
    color: var(--black);
    margin: 0;
    min-height: calc(2 * clamp(3.5rem, 9vw, 8rem) * 0.95);
  }
  .hero-headline-q {
    color: var(--gray-text);
  }
  .hero-sub {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.25rem var(--pad) 1.75rem;
    border-bottom: 1px solid var(--gray-mid);
  }
  .hero-sub-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .hero-sub p {
    font-size: 0.875rem;
    color: var(--gray-text);
    margin: 0;
    line-height: 1.5;
  }
  .hero-date {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--gray-text);
  }
  .hero-photo {
    width: 100%;
    overflow: hidden;
    line-height: 0;
  }
  .hero-photo img {
    width: 100%;
    height: clamp(300px, 50vw, 580px);
    object-fit: cover;
    filter: grayscale(100%);
    display: block;
  }
  .hero-learn-link {
    display: block;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: #555;
    letter-spacing: 0.03em;
    text-decoration: none;
    padding: 1rem 0 0.5rem;
    transition: color 0.15s;
  }
  .hero-learn-link:hover {
    color: #000;
  }

  @media (max-width: 640px) {
    .hero-sub {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* ============================================================
     SECTION BASE
  ============================================================ */
  .section {
    padding: 5rem var(--pad);
    border-top: 1px solid var(--gray-mid);
  }

  .tag {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--gray-text);
    margin: 0 0 2rem;
    display: block;
  }

  /* ============================================================
     O RUÍDO
  ============================================================ */
  .noise-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }
  .noise-left p {
    font-size: 1rem;
    color: var(--gray-text);
    line-height: 1.75;
    margin: 0;
  }
  .noise-right {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .noise-stmt {
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--black);
    line-height: 1.5;
    margin: 0;
  }
  .noise-rule {
    border: none;
    border-top: 1px solid var(--gray-mid);
    margin: 0;
  }

  @media (max-width: 768px) {
    .noise-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  /* ============================================================
     PROTOCOLO 3 DÍAS
  ============================================================ */
  .protocol-h {
    font-family: var(--font-display);
