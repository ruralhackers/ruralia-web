---
import Base from '../layouts/Base.astro';
---

<Base
  title="Páxina non atopada | Rural GPT"
  description="A páxina que buscas non existe. Volve ao inicio de Rural GPT."
  robots="noindex, nofollow"
  alternateUrl="/es/"
  skipHreflang={true}
>
  <section class="section">
    <div class="section-inner error-page">
      <p class="error-code">404</p>
      <h1>Páxina non atopada</h1>
      <p class="error-text">Non atopamos esta páxina. Pode que cambiase de enderezo. Volve ao inicio ou bota unha ollada ao <a href="/talleres/ia-asesorias-xestorias/">obradoiro do 28 de novembro</a>.</p>
      <a href="/" class="btn btn-primary">Volver ao inicio</a>
    </div>
  </section>
</Base>

<style>
  .error-page {
    text-align: center;
    max-width: 560px;
    padding: 4rem 0;
  }
  .error-code {
    font-size: 6rem;
    font-weight: 800;
    color: var(--verde-hoja);
    margin: 0 0 0.5rem;
    line-height: 1;
    letter-spacing: -0.05em;
    opacity: 0.4;
  }
  h1 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }
  .error-text {
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
  }
</style>
