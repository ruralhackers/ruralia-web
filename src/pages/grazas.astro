---
import Base from '../layouts/Base.astro';
---

<Base
  title="Apuntámoste | Rural GPT"
  description="Grazas polo teu interese en Rural GPT. Avisarémosche cando abramos inscricións."
  robots="noindex, nofollow"
>
  <script>
    if (typeof window.fbq === "function") {
      window.fbq("track", "Purchase", {
        content_name: "Residencia IA Galicia",
        value: 150,
        currency: "EUR",
      });
    }
  </script>

  <section class="section">
    <div class="section-inner thanks-page">
      <p class="check-icon">&#10003;</p>
      <h1>¡Praza reservada!</h1>
      <p class="thanks-text">
        Recibirás un email de confirmación con todos os detalles da
        Residencia IA. Se tes algunha dúbida, escríbenos a <strong
          >hola@ruralgpt.gal</strong
        >.
      </p>
      <a href="/" class="btn btn-primary">Volver ao inicio</a>
    </div>
  </section>
</Base>

<style>
  .thanks-page {
    text-align: center;
    max-width: 520px;
    padding: 4rem 0;
  }
  .check-icon {
    font-size: 3rem;
    color: #000;
    margin: 0 0 1rem;
    line-height: 1;
  }
  h1 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }
  .thanks-text {
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
  }
</style>
