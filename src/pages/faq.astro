---
import Base from "../layouts/Base.astro";

const faqs = [
  {
    q: "¿Necesito saber programar?",
    a: "Non. Se sabes usar un navegador e ferramentas dixitais no teu traballo, podes seguir o programa. Isto non é un curso de programación — é un curso de usar IA como ferramenta profesional.",
  },
  {
    q: "¿É só para xente de tecnoloxía?",
    a: "Non. É para calquera profesional que queira integrar IA no seu traballo: deseño, administración, marketing, consultoría, servizos, axencias... Se usas un ordenador para traballar, esta experiencia é para ti.",
  },
  {
    q: "¿E se xa uso ChatGPT?",
    a: "Perfecto, pero probablemente o uses ao 10% da súa capacidade. Na Residencia IA vas moito máis aló: asistentes personalizados, automatizacións, ferramentas de construción, o teu propio stack completo.",
  },
  {
    q: "¿Que pasa se a IA que aprendo queda obsoleta en 2 meses?",
    a: "Por iso non che ensinamos UNHA ferramenta. Ensinámoche a avaliar, comparar e elixir. Ademais, o noso equipo segue investigando cada semana e a comunidade alumni mantense activa con actualizacións.",
  },
  {
    q: "¿Como chego a Anceu?",
    a: "Anceu está a 30 min de Pontevedra e 45 min de Vigo. Se vés en avión, o aeroporto máis cercano é Vigo (VGO). Podemos coordinar transporte dende Pontevedra ou Vigo.",
  },
  {
    q: "¿Que teño que levar?",
    a: "O teu portátil e ganas de aprender. Todo o demais (aloxamento, comidas, materiais, software) está incluído.",
  },
  {
    q: "¿Cal é a política de cancelación?",
    a: "Cancelación gratuíta ata 15 días antes. Entre 15 e 7 días, devolvemos o 50%. Menos de 7 días, non hai devolución (pero podes transferir a túa praza a outra persoa).",
  },
  {
    q: "¿Hai wifi bo?",
    a: "1 Gbps de fibra óptica. Anceu é un coliving tech, a conectividade é prioridade.",
  },
  {
    q: "¿Cantas persoas hai por edición?",
    a: "Máximo 12. Grupos pequenos para atención personalizada.",
  },
  {
    q: "¿Que me levo ao rematar?",
    a: "Ferramentas de IA configuradas e funcionando no teu traballo real, fluxos de automatización, un prototipo propio, acceso á comunidade alumni, materiais e unha sesión de follow-up online ás 2-3 semanas.",
  },
  {
    q: "¿Que pasa se chove?",
    a: "Estamos en Galicia, así que é probable. Toda a formación é en interior. A chuvia é parte do encanto.",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.a,
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Inicio",
        item: "https://ruralgpt.gal/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Preguntas frecuentes",
        item: "https://ruralgpt.gal/faq/",
      },
    ],
  },
];
---

<Base
  title="Preguntas frecuentes — Residencia de IA Rural GPT"
  description="Todo o que necesitas saber sobre a Residencia de IA en Galicia: nivel necesario, que ferramentas se aprenden, política de cancelación e máis."
  keywords={[
    "prezo residencia IA",
    "necesito saber programar IA",
    "como chegar Anceu",
    "que inclúe residencia IA",
    "residencia IA preguntas",
  ]}
  schema={schema}
>
  <section class="section">
    <div class="section-inner content">
      <h1>Preguntas frecuentes</h1>

      <div class="faq-list">
        {
          faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))
        }
      </div>

      <div class="cta-block">
        <p>
          ¿Tes outra pregunta? Escríbenos a <strong>hola@ruralgpt.gal</strong>
        </p>
        <a href="/residencia-ia-galicia/" class="btn btn-primary"
          >Ver a Residencia IA</a
        >
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="contact-inner">
      <h2>¿Tes dúbidas? Escríbenos</h2>
      <p class="contact-sub">Respondémosche en menos de 24h.</p>
      <form
        name="contacto"
        method="POST"
        action="/grazas-contacto/"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="contact-form"
      >
        <input type="hidden" name="form-name" value="contacto" />
        <p style="display:none">
          <label>Non encher: <input name="bot-field" /></label>
        </p>
        <div class="cf-group">
          <label for="cf-nome">Nome</label>
          <input
            type="text"
            id="cf-nome"
            name="nombre"
            required
            placeholder="O teu nome"
          />
        </div>
        <div class="cf-group">
          <label for="cf-email">Email</label>
          <input
            type="email"
            id="cf-email"
            name="email"
            required
            placeholder="ti@email.com"
          />
        </div>
        <div class="cf-group">
          <label for="cf-mensaxe">¿Que queres saber?</label>
          <textarea
            id="cf-mensaxe"
            name="mensaje"
            rows="3"
            placeholder="Cóntanos a túa dúbida..."></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Enviar</button>
      </form>
    </div>
  </section>
</Base>

<style>
  .content {
    max-width: 1100px;
    margin: 0 auto;
  }
  h1 {
    font-size: 2.25rem;
    margin-bottom: 2rem;
  }
  .faq-list {
    margin-top: 1rem;
  }
  .faq-item {
    border-bottom: 1px solid #e5e7eb;
    padding: 1.25rem 0;
  }
  .faq-item summary {
    font-size: 1.1rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .faq-item summary::after {
    content: "+";
    font-size: 1.5rem;
    font-weight: 300;
    color: #999;
    transition: transform 0.2s;
  }
  .faq-item[open] summary::after {
    content: "−";
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item p {
    margin: 0.75rem 0 0;
    color: #555;
    line-height: 1.7;
  }
  .cta-block {
    margin-top: 3rem;
    text-align: center;
  }
  .cta-block p {
    color: #888;
    margin-bottom: 1rem;
  }
  .section-alt {
    background: #f2f2f2;
  }
  .contact-inner {
    max-width: 480px;
    margin: 0 auto;
    text-align: center;
  }
  .contact-inner h2 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .contact-sub {
    color: #888;
    margin-bottom: 2rem;
  }
  .contact-form {
    text-align: left;
  }
  .cf-group {
    margin-bottom: 1.25rem;
  }
  .cf-group label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #555;
    margin-bottom: 0.4rem;
  }
  .cf-group input,
  .cf-group textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    background: #fff;
    color: #000;
    transition: border-color 0.15s;
    box-sizing: border-box;
  }
  .cf-group input:focus,
  .cf-group textarea:focus {
    outline: none;
    border-color: #000;
  }
  .cf-group textarea {
    resize: vertical;
  }
  .contact-form .btn {
    width: 100%;
    margin-top: 0.5rem;
  }
</style>
