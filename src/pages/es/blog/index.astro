---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blogEs')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Base
  title="Blog — IA aplicada para freelancers y profesionales tech | Rural GPT"
  description="Tips, herramientas y guías prácticas de IA para freelancers, webmasters e indie hackers. Por el equipo de Rural GPT."
>
  <section class="section">
    <div class="section-inner">
      <h1>Blog</h1>
      <p class="intro">Tips, herramientas y guías prácticas de IA aplicada para profesionales tech.</p>

      {posts.length === 0 && (
        <p class="empty">Próximamente. Estamos preparando contenido. Síguenos en redes para no perderte nada.</p>
      )}

      <div class="post-list">
        {posts.map((post) => (
          <article class="post-card">
            <a href={`/es/blog/${post.id}/`}>
              <time>{new Date(post.data.date).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
            </a>
          </article>
        ))}
      </div>

      <aside class="blog-cta">
        <p>¿Quieres poner esto en práctica?</p>
        <a href="/es/talleres-otono-2026/">Conoce los talleres de IA de Rural GPT<span aria-hidden="true">→</span></a>
        <span class="blog-cta-note">31 oct · Productividad — 28 nov · Web — Anceu, Galicia</span>
      </aside>
    </div>
  </section>
</Base>

<style>
  .section-inner { max-width: 1100px; margin: 0 auto; }
  h1 { font-size: 2.25rem; margin-bottom: 0.5rem; }
  .intro { color: #666; font-size: 1.1rem; margin-bottom: 2.5rem; }
  .empty { color: #888; font-style: italic; }
  .post-list { display: flex; flex-direction: column; gap: 1rem; }
  .post-card a { display: block; padding: 1.5rem; border: 1px solid #e5e7eb; border-radius: 12px; text-decoration: none; color: inherit; transition: border-color 0.15s, box-shadow 0.15s; }
  .post-card a:hover { border-color: #111; box-shadow: 0 2px 12px rgba(0,0,0,0.04); }
  .post-card time { font-size: 0.85rem; color: #888; }
  .post-card h2 { font-size: 1.25rem; margin: 0.25rem 0 0.5rem; }
  .post-card p { color: #555; font-size: 0.95rem; margin: 0; }
  .blog-cta { margin-top: 3rem; padding: 2rem; border: 1px solid #111; border-radius: 12px; background: #fafafa; }
  .blog-cta p { margin: 0 0 0.75rem; font-weight: 700; }
  .blog-cta a { display: inline-flex; min-height: 44px; align-items: center; gap: 0.5rem; color: #111; font-weight: 700; text-decoration: none; }
  .blog-cta a:hover { color: #2d6a4f; }
  .blog-cta-note { display: block; margin-top: 0.75rem; color: #666; font-size: 0.85rem; }
</style>
